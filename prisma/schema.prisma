generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Question {
  id                  String   @id @default(uuid())
  ano_enem            Int
  ano_ensino_medio    String
  topico_bncc         String
  habilidade_enem     String
  enunciado           String
  alternativas        String   // JSON stringificado
  alternativa_correta String
  dicas_socraticas    String   // JSON stringificado
  revisado_ia         Boolean  @default(false)
  ativo               Boolean  @default(true)
  createdAt           DateTime @default(now())

  interactionLogs     InteractionLog[]
  feedbacks           StudentFeedback[]
  reports             Report[]
  aiReports           AiMessageReport[]
}

// Telemetria para a Pesquisa: Captura as interações com a IA
model InteractionLog {
  id              String   @id @default(uuid())
  questionId      String
  sessionId       String   // ID anônimo da sessão do aluno
  timeSpentMs     Int      // Tempo total gasto na questão
  hintsRequested  Int      // Quantas dicas socráticas foram pedidas
  isCorrect       Boolean  // Se o aluno acertou ou desistiu
  aiModeUsed      String   // 'socratic' ou 'commercial'
  createdAt       DateTime @default(now())

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Feedback Qualitativo: Mede Engajamento e Motivação
model StudentFeedback {
  id              String   @id @default(uuid())
  questionId      String
  sessionId       String
  feeling         String   // ex: 'confiante', 'confuso', 'aprendi_muito'
  difficultyRating Int     // 1 (Muito Fácil) a 5 (Muito Difícil)
  createdAt       DateTime @default(now())

  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Simulação do Usuário SIGAA
model User {
  id            String   @id @default(uuid())
  matricula     String   @unique
  name          String
  email         String?  @unique
  emailVerified DateTime?
  passwordHash  String
  role          String   @default("aluno") // 'aluno', 'professor' ou 'admin'
  serie         String?  // '1º Ano', '2º Ano', '3º Ano' (para alunos)
  curso         String?  // 'Informática', 'Mecatrônica', 'Produção de Moda', 'Externo / Outro'
  isCefet       Boolean  @default(true)
  status        String   @default("active") // 'active' ou 'pending' (para moderação de docentes)
  consentAt     DateTime?
  createdAt     DateTime @default(now())

  teacherClasses   TeacherClass[]
  accessSessions   AccessSession[]
  activityEvents   ActivityEvent[]
  aiMessageReports AiMessageReport[]
}

// Códigos OTP de Verificação por E-mail (Cadastro e Recuperação de Senha)
model VerificationCode {
  id         String   @id @default(uuid())
  email      String
  code       String
  purpose    String   @default("registration") // 'registration' ou 'password_reset'
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([email, code])
}

// Turmas/Cursos atribuídos ao docente
model TeacherClass {
  id        String   @id @default(uuid())
  teacherId String
  serie     String   // '1º Ano', '2º Ano', '3º Ano'
  curso     String   // 'Informática', 'Mecatrônica', 'Produção de Moda'
  createdAt DateTime @default(now())

  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, serie, curso])
  @@index([serie, curso])
}

// Rastreamento de Acesso e Tempo Logado
model AccessSession {
  id         String   @id @default(uuid())
  userId     String
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// Registro Granular de Eventos de Aprendizagem
model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // 'page_view' | 'module_view' | 'video_open' | 'question_open' | 'question_answer'
  target    String?  // identificador de página, módulo ou questão
  meta      String?  // JSON stringificado adicional
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// Reportes de erros em questões (OCR, gabarito, formatação)
model Report {
  id          String   @id @default(uuid())
  questionId  String
  description String
  status      String   @default("pending") // pending, fixed, rejected
  createdAt   DateTime @default(now())

  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

// Monitoramento de consumo de tokens da IA (Exclusivo Admin, com cálculo de reset por tempo)
model TokenUsageLog {
  id                   String   @id @default(uuid())
  model                String   @default("openai/gpt-oss-120b")
  promptTokens         Int      @default(0)
  completionTokens     Int      @default(0)
  totalTokens          Int      @default(0)
  limitTokensTPM       Int?
  remainingTokensTPM   Int?
  resetTokensStr       String?
  limitRequestsRPD     Int?
  remainingRequestsRPD Int?
  resetRequestsStr     String?
  sessionId            String?
  createdAt            DateTime @default(now())
}

// Relatos de falhas pedagógicas ou erros nas respostas da IA (Alucinação, quebra socrática, erro de cálculo, KaTeX)
model AiMessageReport {
  id             String    @id @default(uuid())
  questionId     String?
  userId         String?
  userMatricula  String?
  userRole       String?
  messageContent String    // Conteúdo da resposta da IA que continha erro
  userPrompt     String?   // Mensagem anterior do usuário que contextualiza o erro
  reason         String    // math_error, gave_direct_answer, katex_formatting, hallucination, other
  details        String?   // Explicação adicional fornecida pelo aluno/professor
  socraticStep   Int?      // Etapa do Arco de Maguerez no momento (0 a 4)
  status         String    @default("pending") // pending, reviewed, resolved
  adminNotes     String?   // Anotações da equipe de pesquisa/admin
  createdAt      DateTime  @default(now())

  question       Question? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([questionId])
}
